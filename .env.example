# ── 必填 ──
LLM_API_KEY=sk-your-llm-key
AMAP_KEY=your-amap-web-service-key

# 前端地图 key（Docker 构建时需要，与 AMAP_KEY 可以是同一个应用的不同 key）
VITE_AMAP_KEY=your-amap-js-api-key

